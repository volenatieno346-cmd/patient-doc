<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="471.0" prefWidth="473.0" style="-fx-background-radius: 50; -fx-border-radius: 50;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.patient.patientdoctor.loginController">
   <children>
      <Label alignment="CENTER" layoutX="42.0" layoutY="38.0" prefHeight="35.0" prefWidth="306.0" text="LOGIN PAGE">
         <font>
            <Font name="Arial Black" size="18.0" />
         </font>
      </Label>
      <VBox layoutX="80.0" layoutY="88.0" prefHeight="173.0" prefWidth="339.0">
         <children>
            <TextField fx:id="username" promptText="USERNAME" style="-fx-background-radius: 15;" />
            <Label fx:id="usernamewarning" prefHeight="29.0" prefWidth="210.0" textAlignment="CENTER" />
            <TextField fx:id="employeeid" layoutX="10.0" layoutY="10.0" promptText="EMPLOYEEID" style="-fx-background-radius: 15;" />
            <Label fx:id="employeeidwarning" prefHeight="37.0" prefWidth="213.0" />
            <TextField fx:id="password" layoutX="10.0" layoutY="35.0" promptText="PASSWORD" style="-fx-background-radius: 15;" />
            <Label fx:id="passwordwarning" prefHeight="35.0" prefWidth="215.0" textAlignment="CENTER" />
         </children>
      </VBox>
      <HBox layoutX="108.0" layoutY="289.0" prefHeight="53.0" prefWidth="306.0" spacing="39.0">
         <children>
            <Button fx:id="clear" mnemonicParsing="false" onAction="#clearbtn" style="-fx-background-radius: 20;" text="CLEAR" />
            <Button fx:id="register" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" style="-fx-background-radius: 20;" text="REGISTER" />
            <Button fx:id="login" layoutX="62.0" layoutY="10.0" mnemonicParsing="false" onAction="#onLoginClick" style="-fx-background-radius: 20;" text="LOGIN" />
         </children>
      </HBox>
      <Label fx:id="error" layoutX="46.0" layoutY="332.0" prefHeight="69.0" prefWidth="364.0" textAlignment="CENTER" />
   </children>
</AnchorPane>
